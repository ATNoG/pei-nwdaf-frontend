# Unprefixed vars for Docker Compose interpolation
NGINX_PORT1=80
NGINX_PORT2=443
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=9000
POLICY_HOST=localhost
POLICY_PORT=9999
DASHBOARD_HOST=frontend
DASHBOARD_PORT=5173
ML_HOST=pei-ml
ML_PORT=8060
DECISION_HOST=localhost
DECISION_PORT=9998
DATA_INGESTION_HOST=data-ingestion
DATA_INGESTION_PORT=7000
DATA_STORAGE_HOST=data-storage
DATA_STORAGE_PORT=8000
MLFLOW_HOST=mlflow-server
MLFLOW_PORT=5000

# VITE_ prefixed vars (exposed to browser via import.meta.env, and used by vite.config.js)
VITE_NGINX_PORT1=80
VITE_NGINX_PORT2=443
VITE_KEYCLOAK_HOST=localhost
VITE_KEYCLOAK_PORT=9000
VITE_POLICY_HOST=localhost
VITE_POLICY_PORT=9999
VITE_DASHBOARD_HOST=frontend
VITE_DASHBOARD_PORT=5173
VITE_ML_HOST=pei-ml
VITE_ML_PORT=8060
VITE_DECISION_HOST=localhost
VITE_DECISION_PORT=9998
VITE_DATA_INGESTION_HOST=data-ingestion
VITE_DATA_INGESTION_PORT=7000
VITE_DATA_STORAGE_HOST=data-storage
VITE_DATA_STORAGE_PORT=8000
VITE_MLFLOW_HOST=mlflow-server
VITE_MLFLOW_PORT=5000
VITE_RAW_DATA_URL=http://${VITE_DATA_INGESTION_HOST}:${VITE_DATA_INGESTION_PORT}
VITE_DATA_STORAGE_URL=http://${VITE_DATA_STORAGE_HOST}:${VITE_DATA_STORAGE_PORT}
VITE_ML_URL=http://${VITE_ML_HOST}:${VITE_ML_PORT}
VITE_DATA_INGESTION_WS_URL=ws://${VITE_DATA_INGESTION_HOST}:${VITE_DATA_INGESTION_PORT}
VITE_ML_WS_URL=ws://${VITE_ML_HOST}:${VITE_ML_PORT}
VITE_MLFLOW_URL=/mlflow
