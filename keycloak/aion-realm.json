{
  "realm": "aion",
  "enabled": true,
  "displayName": "AION",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "debug_admin",      "description": "Full access to all pages" },
      { "name": "ml_engineer",      "description": "Access to ML models, analytics, performance, settings" },
      { "name": "policy_manager",   "description": "Access to policy, settings" },
      { "name": "network_engineer", "description": "Access to dashboard, settings" }
    ]
  },
  "clients": [
    {
      "clientId": "aion-frontend",
      "name": "AION Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "ml_engineer",
      "enabled": true,
      "email": "ml_engineer@aion.local",
      "firstName": "ML",
      "lastName": "Engineer",
      "credentials": [{ "type": "password", "value": "ml_engineer", "temporary": false }],
      "realmRoles": ["ml_engineer"]
    },
    {
      "username": "policy_manager",
      "enabled": true,
      "email": "policy_manager@aion.local",
      "firstName": "Policy",
      "lastName": "Manager",
      "credentials": [{ "type": "password", "value": "policy_manager", "temporary": false }],
      "realmRoles": ["policy_manager"]
    },
    {
      "username": "network_engineer",
      "enabled": true,
      "email": "network_engineer@aion.local",
      "firstName": "Network",
      "lastName": "Engineer",
      "credentials": [{ "type": "password", "value": "network_engineer", "temporary": false }],
      "realmRoles": ["network_engineer"]
    },
    {
      "username": "debug_admin",
      "enabled": true,
      "email": "debug_admin@aion.local",
      "firstName": "Debug",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "debug_admin", "temporary": false }],
      "realmRoles": ["debug_admin"]
    }
  ]
}
